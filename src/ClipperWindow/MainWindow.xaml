<Window x:Class="ClipperWindow.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SMS Code Clipper" Width="340" Height="550" ResizeMode="CanMinimize" WindowStyle="None" AllowsTransparency="True"
 WindowStartupLocation="CenterScreen" Icon="icon.ico" Background="Transparent"
 Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI, Microsoft YaHei" FontSize="14"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" KeyDown="WindowKeyDown">
 <Window.Resources>
  <SolidColorBrush x:Key="Paper" Color="#F7F6F1" /><SolidColorBrush x:Key="Ink" Color="#1B1D1F" />
  <SolidColorBrush x:Key="Muted" Color="#6C7174" /><SolidColorBrush x:Key="Rule" Color="#B9BDB9" />
  <SolidColorBrush x:Key="Hover" Color="#EFEEE8" /><SolidColorBrush x:Key="ErrorInk" Color="#B0281C" />
  <SolidColorBrush x:Key="Note" Color="#F7F6F1" /><SolidColorBrush x:Key="Flap" Color="#EFEEE8" />
  <SolidColorBrush x:Key="Accent" Color="#E6E5DE" />
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontFamily" Value="Microsoft YaHei" /></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Ink}" />
   <Setter Property="BorderBrush" Value="{DynamicResource Ink}" /><Setter Property="BorderThickness" Value="1.5" />
   <Setter Property="Padding" Value="10,7" /><Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Ink}" /><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="6,5" /></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource Ink}" /><Setter Property="Foreground" Value="{DynamicResource Note}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,9" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.86" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PrimaryBorder" Property="BorderThickness" Value="2" /><Setter TargetName="PrimaryBorder" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="FontSize" Value="13" /><Setter Property="Margin" Value="0,4" /><Setter Property="Tag" Value="关" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
     <ContentPresenter VerticalAlignment="Center" />
     <Border Grid.Column="1" BorderBrush="{DynamicResource Ink}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Border x:Name="Yes" Padding="0,3"><TextBlock x:Name="YesText" Text="开" HorizontalAlignment="Center" /></Border>
      <Border x:Name="No" Grid.Column="1" Background="{DynamicResource Ink}" Padding="0,3"><TextBlock x:Name="NoText" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Paper}" HorizontalAlignment="Center" /></Border>
     </Grid></Border>
    </Grid><ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Yes" Property="Background" Value="{DynamicResource Ink}" /><Setter TargetName="YesText" Property="Foreground" Value="{DynamicResource Paper}" /><Setter TargetName="No" Property="Background" Value="Transparent" /><Setter TargetName="NoText" Property="Foreground" Value="{DynamicResource Ink}" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Note}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource Ink}" /><Setter Property="BorderThickness" Value="1.5" /><Setter Property="Padding" Value="8,5" /><Setter Property="FontSize" Value="14" /></Style>
 </Window.Resources>
 <Grid x:Name="ReceiptPaper" Background="{DynamicResource Paper}" SizeChanged="ReceiptSizeChanged">
   <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>

   <Grid Grid.Row="0" Margin="24,12,22,0" Background="Transparent" MouseLeftButtonDown="DragReceipt">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="SMS CODE CLIPPER" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="ConnectionNav" Style="{StaticResource Quiet}" Click="ShowConnection" ToolTip="手机连接" AutomationProperties.Name="手机连接">
      <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="StatusHover" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StatusHover" Property="Background" Value="{DynamicResource Hover}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StatusHover" Property="Background" Value="{DynamicResource Hover}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
      <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Muted}" Stroke="{DynamicResource Ink}" StrokeThickness="1" Margin="0,0,6,0" /><TextBlock x:Name="StatusLabel" Text="读取状态" FontSize="12" VerticalAlignment="Center" /></StackPanel>
     </Button>
     <Button Style="{StaticResource Quiet}" Width="28" Click="CloseClick" ToolTip="关闭窗口 (Esc)" AutomationProperties.Name="关闭窗口"><Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" /></Button>
    </StackPanel>
   </Grid>
   <Path Grid.Row="1" Data="M0,0 L292,0" Stretch="Fill" Stroke="{DynamicResource Rule}" StrokeThickness="1" StrokeDashArray="3,3" Margin="24,0" VerticalAlignment="Center" IsHitTestVisible="False" />
   <Grid Grid.Row="2" Margin="24,0,24,4">
    <Grid x:Name="HomePage">
     <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="132" /><RowDefinition Height="18" /><RowDefinition Height="24" /><RowDefinition Height="90" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <TextBlock Text="最新" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
     <Border x:Name="StateStamp" Grid.RowSpan="2" Panel.ZIndex="10" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{DynamicResource ErrorInk}" BorderThickness="1" Padding="2" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
      <Border.LayoutTransform><RotateTransform Angle="-7" /></Border.LayoutTransform>
      <Border BorderBrush="{DynamicResource ErrorInk}" BorderThickness="1" Padding="8,1"><TextBlock x:Name="StateStampText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ErrorInk}" /></Border>
     </Border>
     <StackPanel x:Name="ConnectionIntro" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" Margin="6,4,6,6">
      <Border Background="Transparent" Padding="0,8">
       <StackPanel>
        <TextBlock x:Name="IntroTitle" Text="连接你的 iPhone" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock x:Name="IntroText" Text="配对一次，让验证码自动送达。" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" />
        <Button Content="连接手机  →" Click="ShowConnection" Style="{StaticResource Primary}" />
       </StackPanel>
      </Border>
     </StackPanel>
     <Border x:Name="LatestPanel" Grid.Row="1" Padding="0,6" VerticalAlignment="Center">
      <StackPanel>
       <DockPanel><TextBlock x:Name="CodeTime" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="12" /><TextBlock x:Name="SourceName" Text="" FontSize="13" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></DockPanel>
       <Button x:Name="CodeButton" Click="CopyLatest" HorizontalContentAlignment="Left" Padding="0,8,0,4" BorderThickness="0" IsEnabled="False" ToolTip="点击复制验证码">
        <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left" /></Border></ControlTemplate></Button.Template>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="78" HorizontalAlignment="Left"><TextBlock x:Name="CodeText" Text="等待短信" FontFamily="Consolas" FontSize="44.8" FontWeight="SemiBold" /></Viewbox>
       </Button>
       <TextBlock x:Name="MessageText" Visibility="Collapsed" />
       <TextBlock x:Name="CopyFeedback" Text="点击数字复制" FontSize="12" Foreground="{DynamicResource Muted}" MinHeight="20" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
     </Border>
     <Rectangle Grid.Row="2" Height="8" Margin="-24,0" IsHitTestVisible="False">
      <Rectangle.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,13,8" ViewportUnits="Absolute" Viewbox="0,0,13,8" ViewboxUnits="Absolute" Stretch="None"><DrawingBrush.Drawing><GeometryDrawing Brush="{DynamicResource Rule}"><GeometryDrawing.Geometry><EllipseGeometry Center="6.5,4" RadiusX="2.4" RadiusY="2.4" /></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Rectangle.Fill>
     </Rectangle>
     <DockPanel Grid.Row="3" Margin="0,4,0,0"><Button Style="{StaticResource Quiet}" Content="更多 →" DockPanel.Dock="Right" Click="ShowHistory" FontSize="13" Padding="4,0" /><TextBlock Text="最近" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" /></DockPanel>
     <StackPanel x:Name="HistoryRows" Grid.Row="4" />
     <StackPanel x:Name="SettingsControls" Grid.Row="5" Margin="0,8,0,0">
      <Path Data="M0,0 H292" Stretch="Fill" Stroke="{DynamicResource Rule}" StrokeDashArray="3,3" Margin="0,0,0,10" />
      <DockPanel Margin="0,0,0,5"><TextBlock Text="Insert 键入" FontSize="13" DockPanel.Dock="Left" VerticalAlignment="Center" /><Button Content="保存" DockPanel.Dock="Right" Click="SavePhoneClick" Style="{StaticResource Quiet}" Padding="5,3" FontSize="12" /><TextBox x:Name="Phone" MaxLength="20" Width="110" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="14" Padding="2,2" KeyDown="PhoneKeyDown" AutomationProperties.Name="Insert 键入的手机号" ToolTip="输入后按 Enter 或点保存" /></DockPanel>
      <Grid><CheckBox x:Name="Sound" Content="命中时响铃" Click="SoundClick" /><Button Content="试听" Click="ChimeClick" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="88,0,0,0" Padding="4,2" FontSize="12" Foreground="{DynamicResource Muted}" /></Grid>
      <CheckBox x:Name="AutoCopy" Content="自动复制" Tag="暂停" Click="AutoCopyClick" />
      <CheckBox x:Name="AutoType" Click="AutoTypeClick"><StackPanel Orientation="Horizontal"><TextBlock Text="自动填入" /><TextBlock x:Name="AppsNote" FontSize="11" Foreground="{DynamicResource Muted}" Margin="6,2,0,0" MaxWidth="90" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></StackPanel></CheckBox>
     </StackPanel>

    </Grid>
    <Grid x:Name="DevicesPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="36" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
     <DockPanel><Button Content="← 返回" Style="{StaticResource Quiet}" Click="ShowConnection" DockPanel.Dock="Left" Padding="0,0,12,0" FontSize="14" /><TextBlock Text="选择手机" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
     <DockPanel Grid.Row="1"><Button x:Name="RefreshButton" Content="刷新" Click="RefreshDevicesClick" Style="{StaticResource Quiet}" DockPanel.Dock="Right" /><TextBlock Text="点选你的 iPhone" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" /></DockPanel>
     <StackPanel x:Name="DeviceCards" Grid.Row="2" />
     <DockPanel Grid.Row="3"><Button x:Name="PreviousDevices" Content="← 上页" Click="PreviousDevicesClick" Style="{StaticResource Quiet}" DockPanel.Dock="Left" /><Button x:Name="NextDevices" Content="下页 →" Click="NextDevicesClick" Style="{StaticResource Quiet}" DockPanel.Dock="Right" /><TextBlock x:Name="DevicesPageLabel" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Muted}" /></DockPanel>
    </Grid>
    <Grid x:Name="HelpPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <DockPanel><Button Content="← 返回" Style="{StaticResource Quiet}" Click="ShowConnection" DockPanel.Dock="Left" Padding="0,0,12,0" FontSize="14" /><TextBlock Text="首次连接" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
     <StackPanel Grid.Row="1" Margin="0,12,0,0">
      <Border Background="{DynamicResource Note}" BorderBrush="{DynamicResource Ink}" BorderThickness="1" CornerRadius="0" Padding="14,12" Margin="0,0,0,14">
       <StackPanel>
        <TextBlock Text="01  配对手机" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="在 Windows 蓝牙设置中添加 iPhone，按电脑和手机提示确认配对。" FontSize="14" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,6,0,14" />
        <TextBlock Text="02  允许通知" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="在 iPhone「设置 → 蓝牙」中，点本电脑旁的 ⓘ，开启「共享系统通知」。" FontSize="14" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
       </StackPanel>
      </Border>
      <Button Content="打开系统蓝牙设置" Click="OpenBluetoothSettings" Style="{StaticResource Primary}" />
      <TextBlock Text="完成后返回选择手机，再点连接。" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" />
     </StackPanel>
    </Grid>
    <Grid x:Name="HistoryPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <DockPanel><Button Content="← 返回" Style="{StaticResource Quiet}" Click="ShowHome" DockPanel.Dock="Left" Padding="0,0,12,0" FontSize="14" /><TextBlock Text="最近记录" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AllHistoryRows" Margin="0,8,4,0" /></ScrollViewer>
    </Grid>
   </Grid>
   <Grid Grid.Row="3" Margin="24,0,24,20">
    <Path Data="M0,0 H292" Stretch="Fill" Stroke="{DynamicResource Rule}" StrokeDashArray="3,3" VerticalAlignment="Top" />
    <DockPanel VerticalAlignment="Bottom" ToolTip="本次打开窗口的日期和时间"><TextBlock x:Name="OpenedTime" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Muted}" /><TextBlock x:Name="OpenedDate" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Muted}" /></DockPanel><TextBlock Background="{DynamicResource Paper}" x:Name="Footer" Text="" FontSize="13" Visibility="Collapsed" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
    <Border x:Name="ErrorBox" Padding="0,4,0,10" Background="{DynamicResource Paper}" Visibility="Collapsed"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorInk}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Polite" /></Border>
   </Grid>

   <Grid x:Name="ConnectionOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="#01000000" MouseLeftButtonDown="DismissConnection">
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="248" MinHeight="138" Margin="0,48,22,0" Background="{DynamicResource Note}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12" MouseLeftButtonDown="KeepConnectionOpen">
     <Border.Effect><DropShadowEffect Color="#473E31" BlurRadius="8" ShadowDepth="2" Opacity="0.18" /></Border.Effect>
     <Grid x:Name="ConnectionPage">
      <StackPanel x:Name="ConnectionControls">
       <DockPanel Height="26"><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource Quiet}" Click="CloseConnection" Width="28" Height="26" Padding="0" FontSize="14" AutomationProperties.Name="关闭连接面板" /><TextBlock Text="手机连接" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" /></DockPanel>
       <Grid Margin="0,8,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="SelectedDeviceText" Text="尚未选择" FontSize="16" FontWeight="Medium" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="ConnectionStatusDot" Width="6" Height="6" Margin="0,0,5,0" Fill="{DynamicResource Muted}" /><TextBlock x:Name="ConnectionDetail" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" MaxWidth="88" TextTrimming="CharacterEllipsis" /></StackPanel>
       </Grid>
       <TextBlock x:Name="DeviceFeedback" FontSize="12" Foreground="{DynamicResource Muted}" MaxHeight="36" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Button Content="更换手机" Click="ShowDevices" Style="{StaticResource Quiet}" FontSize="13" MinHeight="30" Padding="0,4,10,4" />
        <Button Grid.Column="1" Content="连接帮助" Click="ShowHelp" Style="{StaticResource Quiet}" FontSize="13" MinHeight="30" Padding="0,4" />
        <Button x:Name="ConnectButton" Grid.Column="2" Content="连接" Click="ConnectClick" FontSize="13" MinHeight="30" Padding="8,4" HorizontalAlignment="Right" IsEnabled="False" />
        <Button x:Name="DisconnectButton" Grid.Column="2" Content="断开" Click="DisconnectClick" Style="{StaticResource Quiet}" FontSize="13" MinHeight="30" Padding="8,4,0,4" HorizontalAlignment="Right" IsEnabled="False" />
       </Grid>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
 </Grid>
</Window>
