<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SmsCodeClipper</AssemblyName>
    <ApplicationIcon>../Assets/icon.ico</ApplicationIcon>
    <ApplicationManifest>../ClipperWindow/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Content Include="../Assets/*" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="SmsCodeClipper.Tests" />
  </ItemGroup>
</Project>
